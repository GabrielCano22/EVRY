{
  "name": "evry",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.14.x",
    "npm": "11.x"
  },
  "overrides": {
    "jsdom": {
      "undici": "7.30.1"
    },
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    }
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run dev --workspace @evry/web",
    "dev:web": "npm run dev --workspace @evry/web",
    "dev:mobile": "npm run start --workspace @evry/mobile",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "pretest": "npm run test:e2e:safety",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace @evry/web",
    "test:e2e": "node scripts/web-e2e-test.mjs",
    "test:e2e:safety": "node --test scripts/web-e2e-test.test.mjs",
    "test:mobile:backend": "node scripts/mobile-backend-test.mjs",
    "test:mobile:backend:safety": "node --test scripts/mobile-backend-test.test.mjs",
    "expo:doctor": "npm run doctor --workspace @evry/mobile",
    "export:mobile": "npm run export --workspace @evry/mobile",
    "api:generate": "node scripts/api-contract.mjs generate",
    "api:check": "node scripts/api-contract.mjs check",
    "api:sync": "node scripts/api-contract.mjs sync",
    "api:verify-backend": "node scripts/api-contract.mjs verify-backend",
    "api:test": "node --test scripts/api-contract.test.mjs"
  },
  "devDependencies": {
    "zod": "4.6.7",
    "cross-env": "10.1.0",
    "openapi-typescript": "7.10.1",
    "playwright-core": "1.62.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "typescript": "^5.9.2",
    "vitest": "4.1.12",
    "vite": "8.2.4"
  }
}
