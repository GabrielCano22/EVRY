{
  "name": "evry",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.14.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run dev --workspace @evry/web",
    "dev:web": "npm run dev --workspace @evry/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace @evry/web",
    "test:e2e": "npm run test:e2e --workspace @evry/web",
    "api:generate": "openapi-typescript packages/api-client/openapi/evry-v1.yaml -o packages/api-client/src/schema.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- packages/api-client/src/schema.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.10.1",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
