{
  "name": "@evry/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@evry/api-client": "*",
    "@evry/design-tokens": "*",
    "@evry/domain": "*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.85.5",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-body-highlighter": "3.2.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "yaml": "2.9.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor": "npx expo-doctor",
    "validate:release-api": "node scripts/validate-release-api.cjs",
    "preexport": "npm run validate:release-api",
    "preexport:android": "npm run validate:release-api",
    "preexport:ios": "npm run validate:release-api",
    "eas-build-post-install": "npm run validate:release-api -- --eas-hook",
    "export": "npm run export:android && npm run export:ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "lint": "expo lint",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:native-config": "node --test scripts/native-theme.test.cjs",
    "test:maestro:safety": "node --test scripts/maestro-safety.test.cjs",
    "test:metro-cache": "node --test scripts/metro-cache.test.cjs",
    "posttest": "npm run test:native-config && npm run test:maestro:safety && npm run test:metro-cache"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
